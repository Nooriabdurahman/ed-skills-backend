generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                  @id @default(autoincrement())
  email             String               @unique
  username          String
  password          String?
  age               Int?
  interests         String[]
  createdAt         DateTime             @default(now())
  bio               String?
  profilePicture    String?
  skills            String?
  appleId           String?              @unique
  googleId          String?              @unique
  totalActivityTime Int                  @default(0)
  certifications    Certification[]
  courseHistory     CourseHistory[]
  progress          CourseProgress[]
  quizAttempts      QuizAttempt[]
  testAttempts      TestAttempt[]
  badges            UserBadge[]
  lessonActivities  UserLessonActivity[]
  medals            UserMedal[]
  points            UserPoint[]
}

model Course {
  id                   Int             @id @default(autoincrement())
  name                 String
  description          String
  subject              String
  icon                 String?
  picture              String?
  materialType         String
  materialCount        String?
  firstRecommendation  String?
  secondRecommendation String?
  quizTotalScore       Int?
  quizPassingScore     Int?
  status               String
  materialStatusType   String
  isCertified          Boolean         @default(false)
  typeImage            String?
  progress             Float?
  duration             String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  dialog               String?
  nextStep             String?
  topic                String?
  trainer              String?
  trainerImage         String?
  content              String?
  contentType          String?
  passingPoints        String?
  points               String?
  type                 String?
  certifications       Certification[]
  courseHistory        CourseHistory[]
  lessons              CourseLesson[]
  quizzes              CourseQuiz[]
  tests                CourseTest[]
}

model CourseLesson {
  id         String               @id @default(uuid())
  name       String
  content    String?
  text       String?
  url        String?
  courseId   Int
  createdAt  DateTime             @default(now())
  video      String?
  fileSize   Int?
  fileType   String?
  course     Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress   CourseProgress[]
  quiz       CourseQuiz?
  test       CourseTest?
  activities UserLessonActivity[]
}

model CourseProgress {
  id        Int          @id @default(autoincrement())
  userId    Int
  lessonId  String
  completed Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  lesson    CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model CourseHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  viewedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model CourseTest {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  icon          String?
  materialType  String?
  passingPoints Int?
  picture       String?
  points        Int?
  status        String?
  topic         String?
  trainer       String?
  trainerImage  String?
  url           String?
  type          String?
  lessonId      String?        @unique
  courseId      Int?
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson        CourseLesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts      TestAttempt[]
  questions     TestQuestion[]

  @@index([courseId])
}

model TestQuestion {
  id        Int          @id @default(autoincrement())
  question  String
  type      String       @default("multiple_choice")
  testId    Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  answers   TestAnswer[]
  test      CourseTest   @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model TestAnswer {
  id         Int          @id @default(autoincrement())
  answer     String
  isCorrect  Boolean      @default(false)
  questionId Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model TestAttempt {
  id               Int        @id @default(autoincrement())
  userId           Int
  testId           Int
  score            Int
  totalQuestions   Int
  correctAnswers   Int
  isPassed         Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  performanceLabel String?
  test             CourseTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
  @@index([userId, testId])
}

model UserPoint {
  id          Int      @id @default(autoincrement())
  userId      Int
  points      Int
  source      String
  testId      Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
}

model CourseQuiz {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  courseId    Int
  badgeId     Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lessonId    String?        @unique
  badge       Badge?         @relation(fields: [badgeId], references: [id])
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      CourseLesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts    QuizAttempt[]
  questions   QuizQuestion[]

  @@index([courseId])
  @@index([badgeId])
}

model QuizQuestion {
  id        Int          @id @default(autoincrement())
  question  String
  quizId    Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  score     Int          @default(1)
  type      String       @default("multiple_choice")
  answers   QuizAnswer[]
  quiz      CourseQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAnswer {
  id         Int          @id @default(autoincrement())
  answer     String
  isCorrect  Boolean      @default(false)
  questionId Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  order      Int?
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id               Int        @id @default(autoincrement())
  userId           Int
  quizId           Int
  score            Int
  totalQuestions   Int
  correctAnswers   Int
  isPassed         Boolean    @default(false)
  badgeEarned      Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  performanceLabel String?
  quiz             CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
  @@index([userId, quizId])
}

model Badge {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  icon        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  quizzes     CourseQuiz[]
  userBadges  UserBadge[]
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  earnedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Certification {
  id             Int      @id @default(autoincrement())
  userId         Int
  courseId       Int
  certificateUrl String?
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Medal {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  icon        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userMedals  UserMedal[]
}

model UserMedal {
  id        Int      @id @default(autoincrement())
  userId    Int
  medalId   Int
  earnedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  medal     Medal    @relation(fields: [medalId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, medalId])
  @@index([userId])
  @@index([medalId])
}

model UserLessonActivity {
  id        Int          @id @default(autoincrement())
  userId    Int
  lessonId  String
  startTime DateTime     @default(now())
  endTime   DateTime?
  duration  Int?
  lesson    CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
}
