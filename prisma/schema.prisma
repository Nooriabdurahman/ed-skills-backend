generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  username       String   
  password       String
  age            Int?
  profilePicture String?  
  bio            String?  
  interests      String[] 
  skills         String?   // اضافه ک
  courseHistory  CourseHistory[]
  medals         UserMedal[]
  createdAt      DateTime @default(now())
}


model Course {
  id                  Int             @id @default(autoincrement())
  name                String
  description         String
  subject             String
  // Fields matching Materials data shape
  trainer             String?          // e.g., "Wali Qadiri"
  trainerImage        String?          // e.g., "/images/SingleCourse/trainerImage.svg"
  dialog              String?          // e.g., "Increase your knowledge with"
  nextStep            String?          // e.g., "Unlock the Power of Place"
  icon                String?  // URL or file path
  picture             String?  // maps to `image`
  materialType        String   // maps to `contentType` ("Courses", "Pages", "Quiz", etc.)
  materialCount       String?  // maps to `content` (e.g., "12 Questions")
  firstRecommendation String?  // maps to `firstRecommendation`
  secondRecommendation String? // maps to `secondRecommendation`
  topic               String?  // maps to `topic`
  quizTotalScore      Int?     // maps to `points`
  quizPassingScore    Int?     // maps to `passingPoints`
  status              String   // e.g., "inProgress", "notStarted"
  materialStatusType  String   // e.g., "StartedQuiz", "StartedCourse", "NotStartedCourse"
  isCertified         Boolean  @default(false)
  typeImage           String?  // URL or file path
  progress            Float?   // 0 to 100
  duration            String?  // e.g., "35 minutes"
  lessons             CourseLesson[]  // ← فیلد رابطه‌ای معکوس
  courseHistory       CourseHistory[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CourseLesson {
  id        String           @id @default(uuid())
  name      String
  content   String?
  text      String?
  url       String?
  video     String?          // Video file stored in Vercel Blob (optional)
  courseId  Int
  course    Course           @relation(fields: [courseId], references: [id])
  resources LessonResource[]
  progress  CourseProgress[]
  createdAt DateTime         @default(now())
}

model LessonResource {
  id          String       @id @default(uuid())
  name        String
  description String?
  fileUrl     String       // URL from Vercel Blob
  fileType    String?      // e.g., "pdf", "doc", "video"
  fileSize    Int?         // File size in bytes
  lessonId    String
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CourseProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model CourseHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// Medal Model - defines medals that can be earned
model Medal {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  icon        String?     // URL or file path for medal icon
  userMedals  UserMedal[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// User Medal Model - tracks which medals users have earned
model UserMedal {
  id        Int      @id @default(autoincrement())
  userId    Int
  medalId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal     Medal    @relation(fields: [medalId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, medalId])
  @@index([userId])
  @@index([medalId])
}
