generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  username       String   
  password       String
  age            Int?
  profilePicture String?  
  bio            String?  
  interests      String[] 
  skills         String?   // اضافه ک
  courseHistory  CourseHistory[]
  // Relations for tests & points
  testAttempts   TestAttempt[]
  points         UserPoint[]
  // Relations for badges, quizzes & certifications
  quizAttempts   QuizAttempt[]
  badges         UserBadge[]
  certifications Certification[]
  medals         UserMedal[]
  lessonActivities UserLessonActivity[]
  createdAt      DateTime @default(now())
}


model Course {
  id                  Int             @id @default(autoincrement())
  name                String
  description         String
  subject             String
  // Fields matching Materials data shape
  trainer             String?          // e.g., "Wali Qadiri"
  trainerImage        String?          // e.g., "/images/SingleCourse/trainerImage.svg"
  dialog              String?          // e.g., "Increase your knowledge with"
  nextStep            String?          // e.g., "Unlock the Power of Place"
  icon                String?  // URL or file path
  picture             String?  // maps to `image`
  materialType        String   // maps to `contentType` ("Courses", "Pages", "Quiz", etc.)
  materialCount       String?  // maps to `content` (e.g., "12 Questions")
  firstRecommendation String?  // maps to `firstRecommendation`
  secondRecommendation String? // maps to `secondRecommendation`
  topic               String?  // maps to `topic`
  quizTotalScore      Int?     // maps to `points`
  quizPassingScore    Int?     // maps to `passingPoints`
  status              String   // e.g., "inProgress", "notStarted"
  materialStatusType  String   // e.g., "StartedQuiz", "StartedCourse", "NotStartedCourse"
  isCertified         Boolean  @default(false)
  typeImage           String?  // URL or file path
  progress            Float?   // 0 to 100
  duration            String?  // e.g., "35 minutes"
  lessons             CourseLesson[]  // ← فیلد رابطه‌ای معکوس
  tests               CourseTest[]
  quizzes             CourseQuiz[]
  certifications      Certification[]
  courseHistory       CourseHistory[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CourseLesson {
  id        String           @id @default(uuid())
  name      String
  content   String?
  text      String?
  url       String?
  video     String?          // Video file stored in Vercel Blob (optional)
  courseId  Int
  course    Course           @relation(fields: [courseId], references: [id])
  resources LessonResource[]
  progress  CourseProgress[]
  activities UserLessonActivity[]
  createdAt DateTime         @default(now())
}

model LessonResource {
  id          String       @id @default(uuid())
  name        String
  description String?
  fileUrl     String       // URL from Vercel Blob
  fileType    String?      // e.g., "pdf", "doc", "video"
  fileSize    Int?         // File size in bytes
  lessonId    String
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CourseProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model CourseHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// Course Test Model - for tests within a course
model CourseTest {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  courseId    Int
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   TestQuestion[]
  attempts    TestAttempt[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([courseId])
}

// Test Question Model
model TestQuestion {
  id        Int            @id @default(autoincrement())
  question  String
  testId    Int
  test      CourseTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers   TestAnswer[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([testId])
}

// Test Answer Model
model TestAnswer {
  id          Int          @id @default(autoincrement())
  answer      String
  isCorrect   Boolean      @default(false)
  questionId  Int
  question    TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([questionId])
}

// Test Attempt Model - tracks user test attempts and awards points
model TestAttempt {
  id             Int        @id @default(autoincrement())
  userId         Int
  testId         Int
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  test           CourseTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  score          Int        // Points earned from this test
  totalQuestions Int        // Total number of questions
  correctAnswers Int        // Number of correct answers
  isPassed       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@index([testId])
  @@index([userId, testId])
}

// User Point Model - tracks points earned by users from tests
model UserPoint {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int      // Points earned
  source      String   // Source of points (e.g., "test", "quiz", "achievement")
  testId      Int?     // If points from a test
  description String?  // Description of how points were earned
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([testId])
}

// Course Quiz Model - for quizzes within a course
model CourseQuiz {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  courseId    Int
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  badgeId     Int?           // Badge awarded for completing this quiz
  badge       Badge?         @relation(fields: [badgeId], references: [id])
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([courseId])
  @@index([badgeId])
}

// Quiz Question Model
model QuizQuestion {
  id        Int            @id @default(autoincrement())
  question  String
  quizId    Int
  quiz      CourseQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers   QuizAnswer[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([quizId])
}

// Quiz Answer Model
model QuizAnswer {
  id          Int          @id @default(autoincrement())
  answer      String
  isCorrect   Boolean      @default(false)
  questionId  Int
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([questionId])
}

// Quiz Attempt Model - tracks user quiz attempts and awards badges
model QuizAttempt {
  id             Int        @id @default(autoincrement())
  userId         Int
  quizId         Int
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           CourseQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int        // Score achieved
  totalQuestions Int        // Total number of questions
  correctAnswers Int        // Number of correct answers
  isPassed       Boolean    @default(false)
  badgeEarned    Boolean    @default(false) // Whether badge was earned
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@index([quizId])
  @@index([userId, quizId])
}

// Badge Model - defines badges that can be earned
model Badge {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  icon        String?     // URL or file path for badge icon
  quizzes     CourseQuiz[]
  userBadges  UserBadge[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// User Badge Model - tracks which badges users have earned
model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// Certification Model - tracks certifications earned when users complete courses
model Certification {
  id             Int      @id @default(autoincrement())
  userId         Int
  courseId       Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateUrl String?  // URL to certificate PDF/image
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

// Medal Model - defines medals that can be earned
model Medal {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  icon        String?     // URL or file path for medal icon
  userMedals  UserMedal[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// User Medal Model - tracks which medals users have earned
model UserMedal {
  id        Int      @id @default(autoincrement())
  userId    Int
  medalId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medal     Medal    @relation(fields: [medalId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, medalId])
  @@index([userId])
  @@index([medalId])
}

model UserLessonActivity {
  id        Int      @id @default(autoincrement())
  userId    Int
  lessonId  String
  startTime DateTime @default(now())
  endTime   DateTime?
  duration  Int?     // duration in seconds
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
}
